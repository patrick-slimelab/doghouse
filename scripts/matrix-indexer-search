#!/usr/bin/env bash
set -euo pipefail

QUERY="${1:-}"

if [[ "$QUERY" == "-h" || "$QUERY" == "--help" || -z "$QUERY" ]]; then
  cat <<HELP
Usage: matrix-indexer-search <text> [--limit N] [--room ROOM_ID] [--sender SENDER] [--from ISO|unix_ms] [--to ISO|unix_ms] [--case-sensitive] [--include-redacted]

Options:
  --limit N            Max rows to return (default: 20)
  --room ROOM_ID       Restrict to a Matrix room_id
  --sender SENDER      Restrict to sender mxid
  --from TIME          Lower time bound (inclusive). Accepts ISO-8601 or unix ms.
  --to TIME            Upper time bound (inclusive). Accepts ISO-8601 or unix ms.
  --case-sensitive     Case-sensitive regex match (default: insensitive)
  --include-redacted   Include messages marked is_redacted=true

By default, redacted messages are omitted.
HELP
  exit 0
fi

shift || true
LIMIT=20
ROOM=""
SENDER=""
FROM_TIME=""
TO_TIME=""
CASE_INSENSITIVE=1
INCLUDE_REDACTED=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --limit) LIMIT="$2"; shift 2;;
    --room) ROOM="$2"; shift 2;;
    --sender) SENDER="$2"; shift 2;;
    --from) FROM_TIME="$2"; shift 2;;
    --to) TO_TIME="$2"; shift 2;;
    --case-sensitive) CASE_INSENSITIVE=0; shift;;
    --include-redacted) INCLUDE_REDACTED=1; shift;;
    *) echo "Unknown arg: $1" >&2; exit 2;;
  esac
done

MONGODB_URI="${MONGODB_URI:-mongodb://mongo:27017}"
MONGODB_DB="${MONGODB_DB:-matrix_index}"

OPTS="i"
[[ "$CASE_INSENSITIVE" == "0" ]] && OPTS=""

regexFilter="{ \"content.body\": { \"\$regex\": \"${QUERY//\"/\\\"}\", \"\$options\": \"$OPTS\" } }"
filters="$regexFilter"

if [[ "$INCLUDE_REDACTED" != "1" ]]; then
  filters="{ \$and: [ $filters, { \$or: [ { is_redacted: { \$exists: false } }, { is_redacted: false } ] } ] }"
fi

to_epoch_ms() {
  local raw="$1"
  [[ -z "$raw" ]] && return 0
  if [[ "$raw" =~ ^[0-9]{10,13}$ ]]; then
    # 10-digit seconds or 13-digit milliseconds
    if [[ ${#raw} -eq 10 ]]; then
      echo "$((raw * 1000))"
    else
      echo "$raw"
    fi
    return 0
  fi
  date -d "$raw" +%s%3N 2>/dev/null || {
    echo "ERROR: invalid time '$raw' (use ISO-8601 or unix ms)" >&2
    exit 2
  }
}

FROM_MS=""
TO_MS=""
[[ -n "$FROM_TIME" ]] && FROM_MS="$(to_epoch_ms "$FROM_TIME")"
[[ -n "$TO_TIME" ]] && TO_MS="$(to_epoch_ms "$TO_TIME")"

[[ -n "$ROOM" ]] && filters="{ \$and: [ $filters, { room_id: \"$ROOM\" } ] }"
[[ -n "$SENDER" ]] && filters="{ \$and: [ $filters, { sender: \"$SENDER\" } ] }"
if [[ -n "$FROM_MS" && -n "$TO_MS" ]]; then
  filters="{ \$and: [ $filters, { origin_server_ts: { \$gte: NumberLong(\"$FROM_MS\"), \$lte: NumberLong(\"$TO_MS\") } } ] }"
elif [[ -n "$FROM_MS" ]]; then
  filters="{ \$and: [ $filters, { origin_server_ts: { \$gte: NumberLong(\"$FROM_MS\") } } ] }"
elif [[ -n "$TO_MS" ]]; then
  filters="{ \$and: [ $filters, { origin_server_ts: { \$lte: NumberLong(\"$TO_MS\") } } ] }"
fi

JS="
var cursor = db.events.find($filters).sort({origin_server_ts: -1}).limit($LIMIT);
cursor.forEach(doc => {
  var ts = doc.origin_server_ts;
  if (typeof ts === 'object' && ts.toNumber) ts = ts.toNumber();
  var date = new Date(Number(ts) || 0).toISOString();
  var body = (doc.content && doc.content.body) ? doc.content.body : '';
  var mark = doc.is_redacted ? ' [REDACTED]' : '';
  print(\`[\${date}] \${doc.sender} in \${doc.room_id}\${mark}: \${body}\`);
});
"

if command -v mongosh >/dev/null 2>&1; then
  mongosh "$MONGODB_URI/$MONGODB_DB" --quiet --eval "$JS"
else
  echo "ERROR: mongosh not found." >&2
  exit 1
fi
